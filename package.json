{
  "name": "benchmarking-accelerator",
  "workspaces": ["frontend", "backend"], 
  "scripts": {
    "dev-frontend": "npm run dev --prefix frontend",
    "dev-backend": "npm run dev --prefix backend",
    "dev": "concurrently \"npm run dev-frontend\" \"npm run dev-backend\"",
    "build-single": "npm run build --prefix frontend && node -e \"require('fs').copyFileSync('frontend/dist/index.html', 'Index.html')\""
  },
  "devDependencies": {
    "concurrently": "latest"
  }
}
